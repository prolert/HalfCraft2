+#include "hc_dig_clip_fxc.h"	// halfcraft: s15, c20 and c21: the cells minecraft dug (the pc's ps20b has them free)
+
+struct PS_INPUT
+{
+#if SEAMLESS
+	float3 SeamlessTexCoord         : TEXCOORD0;            // zy xz
+	float4 detailOrBumpAndEnvmapMaskTexCoord : TEXCOORD1;   // envmap mask
+#else
+	HALF2 baseTexCoord				: TEXCOORD0;
